(defn icon [name] (let [paths {:sun "M12 3v2m0 14v2M3 12h2m14 0h2m-3.6-5.6-1.4 1.4M7 17l-1.4 1.4m0-12 1.4 1.4M17 17l1.4 1.4" :moon "M20 15.5A8.5 8.5 0 0 1 8.5 4 8.5 8.5 0 1 0 20 15.5Z" :instagram "M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5Zm9.5 9.4a4.5 4.5 0 1 1-9 0 4.5 4.5 0 0 1 9 0ZM18 6.2h.01" :arrow "M5 12h14m-6-6 6 6-6 6" :up "M12 19V5m-6 6 6-6 6" :menu "M4 7h16M4 12h16M4 17h16" :shield "M12 3 20 6v5c0 5-3.4 8.5-8 10-4.6-1.5-8-5-8-10V6l8-3Z" :heart "M12 20S4 15 4 9.5A4.5 4.5 0 0 1 12 6a4.5 4.5 0 0 1 8 3.5C20 15 12 20 12 20Z"}] [:svg.icon {:viewBox "0 0 24 24" :aria-hidden true :fill (if (= name :heart) "currentColor" "none") :stroke "currentColor" :stroke-width "1.8" :stroke-linecap "round" :stroke-linejoin "round"} [:path {:d (get paths name)}]]))
(defn go! [page] (swap! app-state assoc :page page :menu-open? false) (.scrollTo js/window #js {:top 0 :behavior "smooth"}))
(defn brand [] [:button.brand {:on-click #(go! :home) :aria-label "Little Paint & Wonder home"} [:img {:src "/assets/brand-logo.png" :alt "Little Paint & Wonder" :width 180 :height 180}]])
(defn theme-toggle [] [:button.icon-button {:on-click #(let [next (if (= "light" (:theme @app-state)) "dark" "light")] (.setItem js/localStorage "lpw-theme" next) (swap! app-state assoc :theme next)) :aria-label "Toggle colour theme"} [icon (if (= "light" (:theme @app-state)) :moon :sun)]])
(defn header [] [:header.site-header [:div.wrap.header-inner [brand] [:nav.desktop-nav {:aria-label "Main navigation"} (for [[id label] nav-items] ^{:key (name id)} [:button {:class (when (= id (:page @app-state)) "active") :on-click #(go! id)} label])] [:div.header-actions [theme-toggle] [:a.instagram-link {:href instagram-url :target "_blank" :rel "noreferrer" :aria-label "Follow Little Paint & Wonder on Instagram"} [icon :instagram]] [:button.menu-button {:on-click #(swap! app-state update :menu-open? not) :aria-label "Open navigation"} [icon :menu]]] (when (:menu-open? @app-state) [:nav.mobile-nav {:aria-label "Mobile navigation"} (for [[id label] nav-items] ^{:key (name id)} [:button {:on-click #(go! id)} label])])]])
(defn hero [] [:section.hero [:div.wrap.hero-grid [:div.hero-copy [:p.eyebrow "A little bit of wonder"] [:h1 "Create, paint" [:br] "and " [:em "wonder."]] [:p.lead "Every Little Paint & Wonder creation starts as a blank canvas. Choose your colours, add your creativity, and make something completely your own."] [:div.hero-actions [:button.button.primary {:on-click #(go! :pricing)} "View pricing" [icon :arrow]] [:a.text-link {:href instagram-url :target "_blank" :rel "noreferrer"} "Follow our creations"]] [:div.trust-row [icon :heart] [:p [:strong "Made with love in Australia"] "Craft activities for little creators aged 3+."]]] [:div.hero-art {:aria-label "Little Paint & Wonder logo artwork"} [:img {:src "/assets/hero-logo-transparent.png" :alt "Little Paint & Wonder creative craft logo" :width 640 :height 640 :fetchpriority "high" :decoding "async"}] [:span.hero-sticker "Made in" [:br] "Australia"]]]])
