(defn pricing [] [:section.pricing-section {:id "pricing"} [:div.wrap [:div.section-heading.pricing-heading [:p.eyebrow "Paint, create & wonder"] [:h2 "Simple pricing for colourful fun."] [:p "Choose a little creative activity or stock up for parties, playdates and special events. Prices shown below are from our current product and party pack guide."]] [:div.pricing-feature-grid [price-card "Paint & Create Plaster Packs" "Handcrafted plaster creation · paintbrush · 6 vibrant paint pots, including pearl & glitter" plaster-packs] [price-card "Party Packs" "Perfect for birthdays, playdates, daycare & special events" party-packs]] [:div.pricing-grid [price-card "Colour Paint Strips" "6 paints" colour-paint-strips] [price-card "Pearl Paint Strips" "6 paints" pearl-paint-strips] [price-card "Mini Brushes" nil mini-brushes] [price-card "Colour Powder" "Available colours: red, yellow, pink, purple & blue · Age 3+" colour-powder]] [:div.pricing-note [:span "✦"] [:p [:strong "Party packs ready to take home"] " While stock lasts · Pre-orders welcome."]] [:div.pricing-safety [:h3 "Colour powder safety"] [:p "For external use only. Do not eat or intentionally inhale the powder. Avoid contact with eyes and keep away from the face and mouth. Use in a well-ventilated area. Wash hands after use. May stain clothing and surfaces. Keep powder dry and stored in a cool, dry place. Stop using if irritation occurs and wash the affected area with clean water."]]]])
